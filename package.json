{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --print-label --parallel app:dev worker:dev db:dev graphql:dev",
    "app:build": "nuxt build",
    "app:dev": "nuxt dev",
    "app:generate": "nuxt generate",
    "app:preview": "nuxt preview",
    "graphql": "graphql-codegen -e",
    "graphql:dev": "graphql-codegen --watch",
    "gm": "tsx --env-file=.env ./node_modules/.bin/graphile-migrate",
    "db:migrate": "gm migrate",
    "db:dev": "npm run gm watch",
    "db:commit": "gm commit",
    "db:uncommit": "gm uncommit",
    "db:reset": "gm reset",
    "db:dump": "gm migrate && gm reset --shadow --erase && gm migrate --shadow --forceActions",
    "db:test": "cross-env NODE_ENV=test NODE_OPTIONS=\"${NODE_OPTIONS:-} -r dotenv/config\" jest",
    "setup:env": "tsx --env-file=.env ./scripts/setup_env.cjs",
    "setup:db": "tsx --env-file=.env ./scripts/setup_db.cjs",
    "setup": "npm run setup:env && npm run setup:db && npm run graphql",
    "lint": "eslint .",
    "worker:dev": "tsx --watch --watch-preserve-output --env-file=.env worker/index.ts",
    "worker:start": "tsx --env-file=.env worker/index.ts",
    "postinstall": "graphql-codegen -e && nuxt prepare",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.worker.json",
    "schema:export": "node scripts/export-schema.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:auth": "node --env-file=.env tests/auth-smoke.mjs",
    "test:shutdown": "node tests/shutdown-smoke.mjs",
    "test:policy": "node tests/graphql-policy-smoke.mjs",
    "test:unit": "node --import=tsx --test tests/*.test.ts",
    "test:ruru": "node tests/ruru-smoke.mjs"
  },
  "dependencies": {
    "@grafserv/persisted": "1.0.0",
    "@graphile-contrib/pg-many-to-many": "2.0.0-rc.2",
    "@graphile-contrib/pg-omit-archived": "4.0.0-rc.1",
    "@graphile/pg-aggregates": "0.2.0-rc.2",
    "@graphile/simplify-inflection": "9.0.0",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/lucide": "1.2.134",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.1",
    "@types/html-to-text": "9.0.4",
    "@types/mjml": "5.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@urql/core": "6.0.3",
    "@urql/exchange-execute": "3.0.0",
    "@urql/exchange-graphcache": "9.0.1",
    "@urql/vue": "2.1.1",
    "dotenv": "18.0.0",
    "grafast": "1.1.3",
    "graphile": "5.1.0",
    "graphql": "16.14.2",
    "graphql-ws": "6.2.2",
    "h3": "1.15.11",
    "html-to-text": "10.0.1",
    "json5": "2.2.3",
    "lodash-es": "4.18.1",
    "mjml": "5.4.1",
    "nodemailer": "10.0.10",
    "npm-run-all": "4.1.5",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-security": "2.6.0",
    "pg": "8.23.0",
    "postgraphile": "5.1.5",
    "postgraphile-plugin-connection-filter": "4.0.1",
    "reka-ui": "2.10.4",
    "typescript": "6.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "wonka": "6.3.6",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.1",
    "@graphql-codegen/client-preset": "6.2.0",
    "@graphql-codegen/urql-introspection": "4.0.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@nuxt/kit": "4.5.2",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.1",
    "cac": "6.7.14",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "graphile-migrate": "1.4.1",
    "graphile-worker": "0.18.0",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "grafast": "$grafast",
    "graphql": "$graphql",
    "h3": "$h3",
    "esbuild": "0.28.2",
    "@bomb.sh/tab": {
      "cac": "6.7.14"
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "db"
  ]
}
