{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --print-label --parallel app:dev worker:dev db:dev graphql:dev",
    "app:build": "nuxt build",
    "app:dev": "nuxt dev",
    "app:generate": "nuxt generate",
    "app:preview": "nuxt preview",
    "graphql": "graphql-codegen -e",
    "graphql:dev": "graphql-codegen --watch",
    "gm": "bun ./node_modules/.bin/graphile-migrate",
    "db:migrate": "bun gm migrate",
    "db:dev": "bun gm watch",
    "db:commit": "bun gm commit",
    "db:uncommit": "bun gm uncommit",
    "db:reset": "bun gm reset",
    "db:dump": "bun gm migrate && bun gm reset --shadow --erase && bun gm migrate --shadow --forceActions",
    "db:test": "cross-env NODE_ENV=test NODE_OPTIONS=\"${NODE_OPTIONS:-} -r dotenv/config\" jest",
    "setup:env": "bun ./scripts/setup_env.js",
    "setup:db": "bun ./scripts/setup_db.js",
    "setup": "npm run setup:env auto && npm run setup:db && npm run graphql",
    "_i18n": "bunx nuxt-i18n-micro-cli",
    "i18n": "i18n-micro",
    "lint": "eslint .",
    "worker:dev": "bun --watch --no-clear-screen worker/index.ts",
    "worker:start": "bun worker/index.ts",
    "postinstall": "nuxt prepare && graphql-codegen -e",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck && tsc -p worker/tsconfig.json",
    "test:smoke": "node --env-file=.env tests/auth-smoke.mjs",
    "schema:export": "node scripts/export-schema.mjs",
    "test:email": "node --import=tsx tests/email-smoke.mjs",
    "test:unit": "node --import=tsx --test tests/*.test.ts",
    "test:policy": "node --env-file=.env tests/policy-smoke.mjs",
    "test:ruru": "node tests/ruru-smoke.mjs"
  },
  "dependencies": {
    "@apollo/client": "4.3.0",
    "@dataplan/json": "1.0.1",
    "@dataplan/pg": "1.1.2",
    "@grafserv/persisted": "1.0.0",
    "@graphile-contrib/pg-many-to-many": "2.0.0-rc.2",
    "@graphile-contrib/pg-omit-archived": "4.0.0-rc.1",
    "@graphile/pg-aggregates": "0.2.0-rc.2",
    "@graphile/simplify-inflection": "9.0.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/test-utils": "4.3.2",
    "@nuxt/ui": "4.11.1",
    "@types/html-to-text": "9.0.4",
    "@types/mjml": "5.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vue/apollo-composable": "5.0.0-alpha.4",
    "grafast": "1.1.3",
    "grafserv": "1.0.2",
    "graphile": "5.1.0",
    "graphile-build": "5.1.1",
    "graphile-utils": "5.0.3",
    "graphql": "16.14.2",
    "graphql-tag": "2.12.7",
    "graphql-ws": "6.2.2",
    "h3": "1.15.11",
    "html-to-text": "10.0.1",
    "json5": "2.2.3",
    "lodash-es": "4.18.1",
    "lru-cache": "11.5.2",
    "mjml": "5.4.1",
    "nodemailer": "10.0.10",
    "npm-run-all": "4.1.5",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-i18n-micro": "3.29.5",
    "nuxt-security": "2.6.0",
    "pg": "8.23.0",
    "pg-sql2": "5.0.1",
    "postgraphile": "5.1.5",
    "postgraphile-plugin-connection-filter": "4.0.1",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@graphql-codegen/add": "7.1.0",
    "@graphql-codegen/cli": "7.4.1",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-codegen/typescript-vue-apollo": "5.0.1",
    "@iconify-json/heroicons": "1.2.3",
    "@iconify-json/lucide": "1.2.134",
    "@nuxt/kit": "4.5.2",
    "@playwright/test": "1.63.0",
    "@types/lodash-es": "4.17.12",
    "@types/ws": "8.18.1",
    "concurrently": "10.0.5",
    "dotenv": "18.0.0",
    "eslint": "10.10.0",
    "graphile-migrate": "1.4.1",
    "graphile-worker": "0.18.0",
    "nuxt-i18n-micro-cli": "2.1.2",
    "tsx": "4.23.13",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "grafast": "1.1.3",
    "graphql": "16.14.2"
  }
}
